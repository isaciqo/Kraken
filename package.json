{
  "name": "kraken-payments",
  "version": "1.0.0",
  "description": "Job that detects valid incoming fiat deposits in banking partner transaction files",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/unit/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/test/unit/setupEnvironment.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
